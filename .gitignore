# Python bytecode, which appears the moment anything here is run or imported.
__pycache__/
*.pyc

# Converter output. batch.py writes out-<map>/<Name>.t3d beside the scripts
# (batch.py, run()), and a single ut3conv.py run does the same wherever -o
# points. Regenerable, and large.
out-*/

# Packaged build artifacts. Regenerable from a build, and binary.
releases/

# gui/ has its own .gitignore for build/ and build-win/.

# pytest's cache, which appears as soon as the tests are run under pytest.
.pytest_cache/

# More converter output. `out-*/` above covers batch.py's per-map folders, but
# a plain `ut3conv.py -o out/...` run and batch.py's summary land here too.
out/
batchresults/

# Debug dumps written beside the scripts while chasing a specific defect: brush
# listings, editor build logs, a heightmap BMP. Root-scoped, so a .txt that is
# part of the project (gui/CMakeLists.txt) is untouched.
/*.txt
/*.bmp
